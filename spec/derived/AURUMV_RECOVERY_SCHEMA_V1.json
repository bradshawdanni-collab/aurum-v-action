{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aurum-v:recovery:specification:frozen:derived-schema:v1",
  "title": "AURUM-V Frozen Recovery Specification - Derived Machine Schema",
