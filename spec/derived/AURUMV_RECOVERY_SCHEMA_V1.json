        "SECRET_HANDLE_SECRET_ID_BOUND": {"const": true},
        "SECRET_HANDLE_ROLE_BOUND": {"const": true},
        "SECRET_HANDLE_EPOCH_BOUND": {"const": true},
        "SECRET_HANDLE_SINGLE_USE": {"const": true},
        "SECRET_HANDLE_REPLAYABLE": {"const": false},
        "SECRET_HANDLE_EXPIRY_REQUIRED": {"const": true},
        "SECRET_HANDLE_MAX_LIFETIME_SECONDS": {"const": 86400}
