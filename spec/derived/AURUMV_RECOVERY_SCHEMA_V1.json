      "properties": {
        "SSS_ARCHITECTURAL_FIT": {"const": "ESTABLISHED"},
        "SSS_ROLE": {"const": "RECOVERY_CUSTODY_MECHANISM"},
        "SSS_IS_AUTHORITY_SOURCE": {"const": false},
        "THRESHOLD_SATISFACTION_IS_AUTHORITY": {"const": false},
        "SECRET_ENCODING": {"const": "CANONICAL_AND_INJECTIVE"},
        "ARBITRARY_SECRET_FIELD_REDUCTION": {"const": "PROHIBITED"},
        "RAW_RECONSTRUCTED_SECRET_EXPORT_PRODUCTION": {"const": "PROHIBITED"},
        "SECRET_HANDLE_INTERNAL_EXPORTABLE": {"const": false},
        "SECRET_HANDLE_REFERENCE_TOKEN_SECRET_BEARING": {"const": false},
        "KEY_WRAP": {"const": "XCHACHA20_POLY1305_PROFILE_BOUND"},
        "KEY_DERIVATION": {"const": "HKDF_SHA256"},
        "AAD_CANONICAL_ENCODING": {"const": "RFC8785_JCS"},
        "SHARE_INTEGRITY": {"const": "REQUIRED"},
        "SHARE_PAYLOAD_BOUND_TO_SIGNATURE": {"const": "REQUIRED"},
        "SHARE_CONFIDENTIALITY_AT_REST": {"const": "REQUIRED"},
        "PRODUCTION_SECRET_OPERATIONS": {"const": "PROTECTED_NATIVE_OR_HSM_BOUNDARY"},
        "RECOVERY_FAILURE_MODE": {"const": "SILENCE"},
        "RECOVERY_PATH_BYPASSES_AAL": {"const": false},
        "SPECIFICATION_FREEZE_READINESS": {"const": "FROZEN"}
      }
    }
